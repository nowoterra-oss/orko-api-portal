}

### 3b. Ihracat dosya bilgisi getir - Evrim dosya numarasi ile
@exportDosyaNo = BURAYA-EVRIM-DOSYA-NO-YAZIN
GET {{evrimBaseUrl}}/export?dosyaNo={{exportDosyaNo}}
Authorization: Bearer {{token}}

### 3c. Ihracat dosya bilgisi getir - Referans numarasi ile
GET {{evrimBaseUrl}}/export?referansNo=ORK-2026-EXP-001
Authorization: Bearer {{token}}

### 3d. Ihracat dosya bilgisi getir - Beyanname numarasi ile
@exportBeyannameNo = BURAYA-BEYANNAME-NO-YAZIN
GET {{evrimBaseUrl}}/export?beyannameNo={{exportBeyannameNo}}
Authorization: Bearer {{token}}

### ============================================================
### 4. XML ILE DOSYA OLUSTURMA
### ============================================================

### 4a. XML ile dosya olustur
POST {{evrimBaseUrl}}/create-xml
Content-Type: application/xml
Authorization: Bearer {{token}}

<Declaration>
  <RefId>ORK01</RefId>
  <DosyaTipi>T</DosyaTipi>
  <ReferansNo>ORK-2026-XML-001</ReferansNo>
  <MusteriVergi>1234567890</MusteriVergi>
  <MusteriUnvani>Test Firma A.S.</MusteriUnvani>
  <Gumruk>340100</Gumruk>
</Declaration>

### ============================================================
### 5. REZERVASYON (ToReserve)
### ============================================================

### 5a. Rezervasyon olustur
POST {{evrimBaseUrl}}/ToReserve
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "refId": "ORK01",
  "dosyaTipi": "T",
  "referansNo": "ORK-2026-RSV-001",
  "musteriVergi": "1234567890",
  "musteriUnvani": "ABC Makine Sanayi A.S.",
  "gumruk": 340100,
  "rejimKodu": "4000",
  "toplamFatura": 50000,
  "toplamFaturaDovizi": "EUR"
}

### ============================================================
### 6. DURUM (STATUS) ISLEMLERI
### ============================================================

### 6a. Durum olustur
POST {{evrimBaseUrl}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "referansNo": "ORK-2026-IMP-001",
  "fileReferansNo": "",
  "tip": "T",
  "dosyaNo": ""
}

### 6b. Durum getir - Referans numarasi ile
GET {{evrimBaseUrl}}/status?referansNo=ORK-2026-IMP-001
Authorization: Bearer {{token}}

### 6c. Durum getir - Dosya numarasi ile
GET {{evrimBaseUrl}}/status?dosyaNo={{importDosyaNo}}&tip=T
Authorization: Bearer {{token}}

### 6d. Durum getir - File referans numarasi ile
GET {{evrimBaseUrl}}/status?fileReferansNo={{importDosyaNo}}
Authorization: Bearer {{token}}

### ============================================================
### 7. MASRAF (EXPENSES) ISLEMLERI
### ============================================================

### 7a. Masraf olustur
POST {{evrimBaseUrl}}/expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "Dosya No": "",
  "referansNo": "ORK-2026-IMP-001",
  "Tip": "T"
}

### 7b. Masraf guncelle
PUT {{evrimBaseUrl}}/expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "Dosya No": "",
  "referansNo": "ORK-2026-IMP-001",
  "Tip": "T"
}

### 7c. Masraf getir - Dosya numarasi ile
GET {{evrimBaseUrl}}/expenses?Dosya%20No={{importDosyaNo}}&Tip=T
Authorization: Bearer {{token}}

### 7d. Masraf getir - Referans numarasi ile
GET {{evrimBaseUrl}}/expenses?referansNo=ORK-2026-IMP-001&Tip=T
Authorization: Bearer {{token}}

### ============================================================
### 8. IS EMRI (WORKORDER) ISLEMLERI
### ============================================================

### 8a. Is emri olustur
POST {{evrimBaseUrl}}/workorder
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "referansNo": "ORK-2026-IMP-001"
}

### 8b. Is emri guncelle
PUT {{evrimBaseUrl}}/workorder
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "referansNo": "ORK-2026-IMP-001"
}

### 8c. Is emri getir
GET {{evrimBaseUrl}}/workorder?referansNo=ORK-2026-IMP-001
Authorization: Bearer {{token}}

### 8d. Is emrini gumrukçuye gonder
POST {{evrimBaseUrl}}/sendworkorder
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "referansNo": "ORK-2026-IMP-001"
}

### 8e. Is emri arsivini gumrukcuye gonder
POST {{evrimBaseUrl}}/sendworkorderarchive
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "referansNo": "ORK-2026-IMP-001"
}

### ============================================================
### 9. ARSIV (ARCHIVE) ISLEMLERI
### ============================================================

### 9a. Arsiv dosyasi getir (tek PDF)
@evrimBeyannameId = BURAYA-EVRIM-BEYANNAME-ID-YAZIN
GET {{evrimBaseUrl}}/archive?id={{evrimBeyannameId}}
Authorization: Bearer {{token}}

### ============================================================
### 10. BEYANNAME GORUNTULEME VE KONTROL
### ============================================================

### 10a. Beyanname goruntusu getir
@declarationImageId = BURAYA-ID-YAZIN
@declarationImageDosya = BURAYA-DOSYA-YAZIN
GET {{evrimBaseUrl}}/declaration-image?id={{declarationImageId}}&dosya={{declarationImageDosya}}
Authorization: Bearer {{token}}

### 10b. Beyanname kontrol (dosya kontrol baslat)
@evrimDosyaNoKontrol = BURAYA-EVRIM-DOSYA-NO-YAZIN
GET {{evrimBaseUrl}}/beyanname-kontrol?beyannameId={{evrimDosyaNoKontrol}}
Authorization: Bearer {{token}}

### 10c. Beyanname kontrol sonuc
GET {{evrimBaseUrl}}/beyanname-kontrol-sonuc?beyannameId={{evrimDosyaNoKontrol}}
Authorization: Bearer {{token}}

### 10d. Beyanname kontrol genel
GET {{evrimBaseUrl}}/beyanname-kontrol-genel?beyannameId={{evrimDosyaNoKontrol}}
Authorization: Bearer {{token}}

### ============================================================
### 11. UCTAN UCA TEST SENARYOSU
### ============================================================
###
### Adim adim calistirin:
###
### 1) Login yapip JWT token alin              -> 1a
### 2) Token'i @token degiskenine yapisitirin
### 3) Ithalat dosyasi olusturun               -> 2a (dosyaNo'yu not alin)
### 4) Dosya bilgisi kontrol edin              -> 2b veya 2c
### 5) Durum sorgulama yapin                   -> 6b
### 6) Ihracat dosyasi olusturun               -> 3a (dosyaNo'yu not alin)
### 7) Dosya bilgisi kontrol edin              -> 3b veya 3c
### 8) Is emri olusturun                       -> 8a
### 9) Beyanname kontrolu yapin                -> 10b
### 10) Kontrol sonucunu goruntuleyin          -> 10c
### 11) Arsivi cekerek kontrol edin            -> 9a
###
### ============================================================